{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deep Interview",
  "version": "0.1.0",
  "identifier": "com.deepinterview.assistant",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Deep Interview · 个人助手",
        "width": 420,
        "height": 670,
        "minWidth": 360,
        "minHeight": 540,
        "center": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "contentProtected": true,
        "visible": false,
        "focus": false,
        "resizable": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; font-src 'self'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/icon.ico"] }
}
